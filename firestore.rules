rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedOwner(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    // Admin authorization is exclusively a trusted Firebase Auth custom claim.
    // A users/{uid}.role field is profile data and is never used for access.
    function trustedAdmin() {
      return signedIn()
        && request.auth.token.admin == true
        && request.auth.token.email_verified == true;
    }

    function optionalString(data, field, maxLength) {
      return !(field in data)
        || (data[field] is string && data[field].size() <= maxLength);
    }

    function optionalTimestamp(data, field) {
      return !(field in data) || data[field] is timestamp;
    }

    function validElectives(data) {
      return !('electives' in data)
        || (data.electives is list
          && data.electives.size() <= 20
          && data.electives.hasOnly([
            'AEC', 'VEC', 'IKS',
            'Psychology', 'Philosophy', 'Economics', 'English', 'History',
            'Politics', 'Geography', 'SEC Psychology', 'SEC Economics',
            'SEC English', 'SEC Politics', 'SEC History', 'OE Zoology',
            'OE Botany', 'OE Electronics', 'OE Geology', 'OE Geography'
          ]));
    }

    // Validate any supported profile data without requiring optional details.
    // Course and class remain accepted for legacy profiles but new app profiles
    // use the shared academic configuration instead.
    function validProfileValues(data, uid) {
      return (!('uid' in data) || (data.uid is string && data.uid == uid))
        && optionalString(data, 'email', 254)
        && (!('email' in data) || data.email == request.auth.token.email)
        && optionalString(data, 'name', 100)
        && optionalString(data, 'course', 80)
        && optionalString(data, 'studentClass', 40)
        && optionalString(data, 'division', 80)
        && optionalString(data, 'rollNo', 40)
        && optionalString(data, 'prn', 40)
        && optionalString(data, 'whatsapp', 24)
        && optionalString(data, 'telegram', 40)
        && optionalString(data, 'bio', 500)
        && (!('avatar' in data) || (data.avatar is string
          && data.avatar in ['portrait', 'owl', 'book', 'fox', 'moon', 'star']))
        && validElectives(data)
        && (!('role' in data) || data.role is string)
        && (!('emailVerified' in data) || data.emailVerified is bool)
        && (!('profileSetupComplete' in data) || data.profileSetupComplete is bool)
        && optionalTimestamp(data, 'createdAt')
        && optionalTimestamp(data, 'updatedAt')
        && (!('updatedAt' in data) || data.updatedAt == request.time);
    }

    function validStudentProfileCreate(data, uid) {
      return data.keys().hasOnly([
          'uid', 'email', 'name', 'course', 'studentClass', 'division',
          'rollNo', 'prn', 'whatsapp', 'telegram', 'bio', 'avatar', 'electives',
          'role', 'emailVerified', 'profileSetupComplete', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll(['uid', 'role'])
        && data.uid is string && data.uid == uid
        && data.role is string && data.role == 'Student'
        && validProfileValues(data, uid)
        && (!('createdAt' in data) || data.createdAt == request.time);
    }

    function validChangedProfileValues(data, uid, changed) {
      return (!('uid' in changed) || (data.uid is string && data.uid == uid))
        && (!('role' in changed) || (data.role is string && data.role == 'Student'))
        && (!('email' in changed) || (data.email is string
          && data.email.size() <= 254
          && data.email == request.auth.token.email))
        && (!('name' in changed) || (data.name is string
          && data.name.size() >= 1 && data.name.size() <= 100))
        && (!('division' in changed) || (data.division is string && data.division.size() <= 80))
        && (!('rollNo' in changed) || (data.rollNo is string && data.rollNo.size() <= 40))
        && (!('prn' in changed) || (data.prn is string && data.prn.size() <= 40))
        && (!('whatsapp' in changed) || (data.whatsapp is string && data.whatsapp.size() <= 24))
        && (!('telegram' in changed) || (data.telegram is string && data.telegram.size() <= 40))
        && (!('bio' in changed) || (data.bio is string && data.bio.size() <= 500))
        && (!('avatar' in changed) || (data.avatar is string
          && data.avatar in ['portrait', 'owl', 'book', 'fox', 'moon', 'star']))
        && (!('electives' in changed) || validElectives(data))
        && (!('emailVerified' in changed) || (data.emailVerified is bool && data.emailVerified == true))
        && (!('profileSetupComplete' in changed) || data.profileSetupComplete is bool)
        && (!('updatedAt' in changed) || (data.updatedAt is timestamp && data.updatedAt == request.time));
    }

    function validProfileUpdate(data, uid) {
      let changed = data.diff(resource.data).affectedKeys();
      return validChangedProfileValues(data, uid, changed)
        // Existing identity/role values are immutable. Legacy documents that
        // lack these fields may only receive their canonical UID / Student role.
        && ((!('uid' in resource.data) && data.uid == uid)
          || ('uid' in resource.data && data.uid == resource.data.uid))
        && ((!('role' in resource.data) && data.role == 'Student')
          || ('role' in resource.data && data.role == resource.data.role))
        && ((!('createdAt' in resource.data) && !('createdAt' in data))
          || ('createdAt' in resource.data && data.createdAt == resource.data.createdAt))
        && changed.hasOnly([
          'uid', 'role', 'email', 'name', 'division', 'rollNo', 'prn',
          'whatsapp', 'telegram', 'bio', 'avatar', 'electives',
          'emailVerified', 'profileSetupComplete', 'updatedAt'
        ]);
    }

    match /users/{uid} {
      // Private profile documents are visible only to the verified owner.
      allow get: if verifiedOwner(uid);
      allow list: if false;

      allow create: if verifiedOwner(uid)
        && validStudentProfileCreate(request.resource.data, uid);

      allow update: if verifiedOwner(uid)
        && validProfileUpdate(request.resource.data, uid);

      allow delete: if false;
    }

    // Admin dashboard data is visible only to verified custom-claim Admins.
    match /admin/{document=**} {
      allow get, list: if trustedAdmin();
      allow create, update, delete: if false;
    }

    // Activity is append-only from trusted server code (Admin SDK bypasses rules).
    match /adminActivity/{logId} {
      allow get, list: if trustedAdmin();
      allow create, update, delete: if false;
    }
  }
}
